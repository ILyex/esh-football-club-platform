{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "esh",
	"main": "cloudflare/worker.mjs",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true
		}
	],
	"vars": {
		"DEPLOY_TARGET": "cloudflare",
		"PUBLIC_SITE_ONLY": "false",
		"AI_ENABLED": "true",
		"AI_PROVIDER": "cloudflare",
		"AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		"AI_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		"NEXT_PUBLIC_AI_ENABLED": "true",
		"FAF_ENABLED": "true",
		"FAF_PORTAL_URL": "https://ems.fafconnect.dz",
		"FAF_CLUB_CODE": "14DLG9D",
		"AUTH_URL": "https://esh.football-club-platform.workers.dev",
		"NEXTAUTH_URL": "https://esh.football-club-platform.workers.dev",
		"NEXT_PUBLIC_PUBLIC_SITE_URL": "https://esh.football-club-platform.workers.dev",
		"STORAGE_DRIVER": "s3",
		"STORAGE_ENDPOINT": "https://br-weathered-voice-b4xw8lji.storage.c-6.us-east-2.aws.neon.tech",
		"STORAGE_REGION": "us-east-2",
		"STORAGE_FORCE_PATH_STYLE": "true",
		"STORAGE_PRIVATE_BUCKET": "esh-private",
		"STORAGE_PUBLIC_BUCKET": "esh-public"
	},
	"queues": {
		"producers": [
			{ "binding": "GOAL_PUSH_QUEUE", "queue": "esh-goal-push" }
		],
		"consumers": [
			{
				"queue": "esh-goal-push",
				"max_batch_size": 1,
				"max_batch_timeout": 0,
				"max_retries": 8,
				"dead_letter_queue": "esh-goal-push-dead"
			}
		]
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
}
