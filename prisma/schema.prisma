  TESTING_RETEST_DUE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String?
  // Insight params captured at creation. The notifications page renders the
  // localized text from `insights.types.<type>` + these params in the VIEWER's
  // locale (ar/fr); `title` remains as the fallback for rows created before
  // this column existed.
  params    Json?
  link      String? // internal dashboard path, e.g. "/dashboard/contracts/abc123"
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  teamId    String? // P5: Explicit team scoping (nullable for club-wide notifications)
  dedupKey  String?          @unique // P5: Database-level deduplication key

  @@index([userId, isRead])
  @@index([teamId])
