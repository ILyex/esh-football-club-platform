  NEW_CORRESPONDENCE
  UPCOMING_MATCH
  UPCOMING_TRAINING
  NEW_ANNOUNCEMENT
  PERMISSION_CHANGED
  PLAYER_MISSING_DOCUMENTS
  MATCH_REPORT_MISSING
  MATCH_MISSING_INFO
  TRAINING_ATTENDANCE_MISSING
