// ============================================================================
// PHASE 15 — PLAYER TESTING & PERFORMANCE ENGINE
// ============================================================================

enum TestCategory {
  ENDURANCE
  SPEED
  AGILITY
  POWER
  STRENGTH
  FLEXIBILITY
  OTHER
}

enum MetricDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  NEUTRAL
}

enum TestSessionStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum TestResultStatus {
  VALID
  INCOMPLETE
  DISQUALIFIED
  ABSENT
}

model TestDefinition {
  id                  String          @id @default(cuid())
  code                String          @unique
  name                String
  category            TestCategory    @default(ENDURANCE)
  description         String?         @db.Text
  primaryUnit         String
  secondaryUnit       String?
  direction           MetricDirection @default(HIGHER_IS_BETTER)
  calculationStrategy String          @default("YOYO_IR1")
  defaultRetestDays   Int?            @default(42)
  instructions        String?         @db.Text
  active              Boolean         @default(true)
  version             Int             @default(1)
  displayOrder        Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions TestSession[]

  @@index([category])
  @@index([active])
}

model TestSession {
  id               String            @id @default(cuid())
  testDefinitionId String
  testDefinition   TestDefinition    @relation(fields: [testDefinitionId], references: [id])
  teamId           String
  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  conductorId      String
  conductor        User              @relation("UserConductedTestSessions", fields: [conductorId], references: [id])
  title            String
  date             DateTime
  location         String?
  notes            String?           @db.Text
  status           TestSessionStatus @default(DRAFT)
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  results TestResult[]

  @@index([teamId])
  @@index([testDefinitionId])
  @@index([date])
  @@index([status])
}

model TestResult {
  id               String           @id @default(cuid())
  sessionId        String
  session          TestSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId         String
  player           Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status           TestResultStatus @default(VALID)
  summaryScore     Float?
  secondaryScore   Float?
  primaryUnit      String?
  scoreDisplay     String?
  rank             Int?
  notes            String?          @db.Text
  isCorrected      Boolean          @default(false)
  correctionReason String?          @db.Text
  correctedById    String?
  correctedAt      DateTime?
  originalData     Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  measurements Measurement[]

  @@unique([sessionId, playerId])
  @@index([playerId])
  @@index([sessionId])
  @@index([summaryScore])
}

model Measurement {
  id           String     @id @default(cuid())
  resultId     String
  result       TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  key          String
  value        String
  numericValue Float?
  unit         String?
  attempt      Int        @default(1)
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([resultId])
  @@index([key])
}

// Anonymous first-party public-site metrics. No IP address, account identity,
// page query string, or link text is stored.
model WebsiteAnalyticsEvent {
  id         String   @id @default(cuid())
  type       String
  path       String
  targetPath String?
  visitorKey String
  device     String
  source     String
  createdAt  DateTime @default(now())

  @@index([createdAt, type])
  @@index([path, createdAt, type])
  @@index([visitorKey, createdAt])
}

// Shared atomic request counters for login/search throttling across app replicas.
model RateLimitBucket {
  key             String   @id
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}
