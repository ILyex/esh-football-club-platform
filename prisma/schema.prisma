// ============================================================================
// P5 — BACKGROUND JOBS & QUEUE
// ============================================================================
enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  RETRYING
  FAILED
  CANCELLED
}

enum JobPriority {
  LOW
  DEFAULT
  HIGH
  CRITICAL
}

model BackgroundJob {
  id          String      @id @default(cuid())
  type        String // e.g. "insights.sync", "notification.dispatch"
  payload     Json // Strictly references/parameters, never credentials or secrets
  status      JobStatus   @default(QUEUED)
  priority    JobPriority @default(DEFAULT)
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)

  // Scheduling & Timing
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  nextRetryAt DateTime?

  // Concurrency & Lease Fencing
  lockedBy    String? // Worker instance identifier
  lockedUntil DateTime? // Lease deadline for crash recovery

  // Errors & Diagnostics (sanitized, size-bounded)
  lastError    String?
  errorDetails Json?

  // Idempotency & Tracing
  idempotencyKey String? @unique
  correlationId  String?
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([status, lockedUntil])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// FINANCE & TREASURY
// ----------------------------------------------------------------------------
// Four distinct concepts, deliberately never conflated (see engineering
// report): Budget (authorized amount) vs Expense (an obligation/spend,
// DRAFT until POSTED) vs TreasuryAccount (a real cash/bank account) vs
// TreasuryTransaction (the ledger — the ONLY authoritative record of money
// actually moving). TreasuryAccount has no cached mutable balance field on
// purpose: current balance is always openingBalance + Σ(deposits) −
// Σ(withdrawals) over posted ledger rows, computed on read inside a
// SERIALIZABLE transaction when a new movement is being validated — there is
// no independent writable balance that could drift from the ledger.
// ============================================================================

enum BudgetStatus {
  ACTIVE
  CLOSED
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  LODGING
  EQUIPMENT
  MEDICAL
  ADMINISTRATION
  TRAINING
  MATCH
  TRAVEL
  OTHER
}

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum TreasuryAccountType {
  CASH
  BANK
  OTHER
}

enum TreasuryTransactionType {
  DEPOSIT
  WITHDRAWAL
}

model Budget {
  id              String           @id @default(cuid())
  seasonId        String
  season          Season           @relation(fields: [seasonId], references: [id])
  teamId          String? // null = club-level budget — spec: do not blindly make everything team-scoped
  team            Team?            @relation(fields: [teamId], references: [id])
  category        ExpenseCategory?
  allocatedAmount Int // whole DZD — see money-representation note in the engineering report; never Float
  currency        String           @default("DZD")
  status          BudgetStatus     @default(ACTIVE)
  notes           String?          @db.Text
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  expenses Expense[]

  @@index([seasonId, teamId])
  @@index([status])
}

model Expense {
  id                String           @id @default(cuid())
  referenceNumber   String           @unique
  amount            Int // whole DZD, always positive (enforced in validation, never trusted from the client alone)
  currency          String           @default("DZD")
  category          ExpenseCategory
  date              DateTime
  description       String
  payeeName         String? // free text — deliberately not a Staff/Player relation (a Staff member may belong to multiple teams; this avoids ever inferring an expense's team from a payee's team)
  paymentMethod     PaymentMethod?
  teamId            String?
  team              Team?            @relation(fields: [teamId], references: [id])
  seasonId          String
  season            Season           @relation(fields: [seasonId], references: [id])
  budgetId          String?
  budget            Budget?          @relation(fields: [budgetId], references: [id])
  relatedMatchId    String?
  relatedMatch      Match?           @relation(fields: [relatedMatchId], references: [id])
  relatedTrainingId String?
  relatedTraining   TrainingSession? @relation(fields: [relatedTrainingId], references: [id])
  status            ExpenseStatus    @default(DRAFT) // only POSTED counts toward budget/expenditure calculations
  documentId        String?          @unique // optional supporting document (receipt/invoice) — reuses the existing Document registry
  document          Document?        @relation(fields: [documentId], references: [id])
  notes             String?          @db.Text
  createdById       String
  createdBy         User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedById       String?
  updatedBy         User?            @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  treasuryTransaction TreasuryTransaction? // at most one payment movement per expense — prevents double-counting by construction (see relatedExpenseId @unique below)

  @@index([status])
  @@index([teamId])
  @@index([seasonId])
  @@index([category])
  @@index([date])
}

model TreasuryAccount {
  id             String              @id @default(cuid())
  name           String
  type           TreasuryAccountType @default(CASH)
  currency       String              @default("DZD")
  openingBalance Int                 @default(0)
  active         Boolean             @default(true)
  notes          String?             @db.Text
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  transactions TreasuryTransaction[]

  @@index([active])
}

model TreasuryTransaction {
  id                      String                  @id @default(cuid())
  referenceNumber         String                  @unique
  idempotencyKey          String                  @unique // server-generated per form render; a resubmit collides here instead of double-posting
  treasuryAccountId       String
  treasuryAccount         TreasuryAccount         @relation(fields: [treasuryAccountId], references: [id])
  type                    TreasuryTransactionType
  amount                  Int // always positive; direction comes from `type`, never a signed amount
  currency                String                  @default("DZD")
  transactionDate         DateTime
  description             String?
  // Immutable snapshot captured atomically at write time inside the same
  // SERIALIZABLE transaction that validated sufficiency — NEVER edited
  // afterward, and NEVER itself the source of truth for later balance
  // calculations (the ledger sum always is). Kept for receipts/audit only.
  balanceBefore           Int
  balanceAfter            Int
  relatedExpenseId        String?                 @unique // at most one transaction per expense
  relatedExpense          Expense?                @relation(fields: [relatedExpenseId], references: [id])
  documentId              String?                 @unique
  document                Document?               @relation(fields: [documentId], references: [id])
  reversalOfTransactionId String?                 @unique
  reversalOfTransaction   TreasuryTransaction?    @relation("Reversal", fields: [reversalOfTransactionId], references: [id])
  reversedBy              TreasuryTransaction?    @relation("Reversal")
  createdById             String
  createdBy               User                    @relation(fields: [createdById], references: [id])
  createdAt               DateTime                @default(now())

  @@index([treasuryAccountId, transactionDate])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "player.create", "document.download"
  entityType String // e.g. "Player", "Document"
  entityId   String?
  changes    Json? // before/after diff where relevant
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

