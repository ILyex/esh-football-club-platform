// ============================================================================
// DOCUMENT TEMPLATE ENGINE (spec: "one of the most important features")
// ----------------------------------------------------------------------------
// The official template file is uploaded ONCE (into the same private bucket
// as regular Documents — see lib/storage.ts) and never re-uploaded. Its
// design (logo, header, footer, tables, typography) is preserved exactly:
// generation only ever replaces {{PLACEHOLDER}} tokens inside the existing
// .docx via docxtemplater — it never rebuilds the document from scratch.
// ============================================================================

enum TemplateType {
  MATCH_REPORT
  MEETING_MINUTES
  CORRESPONDENCE
  ANNOUNCEMENT
  PLAYER_REPORT
  TRAINING_REPORT
  ADMINISTRATIVE_REPORT
  EXPENSE_STATEMENT
  DEPOSIT_RECEIPT
  WITHDRAWAL_RECEIPT
  OTHER
}

enum TemplateVersionStatus {
  DRAFT // uploaded, fields detected, mapping not yet confirmed
  ACTIVE // mapping confirmed — usable for generation
  ARCHIVED // superseded by a newer version; kept for historical GeneratedDocuments
}

// Where a placeholder's value comes from when generating a document.
enum FieldSourceType {
  DATABASE_FIELD // auto-filled from the related entity (e.g. "match.homeTeamName")
  MANUAL_INPUT // the user types it in at generation time (e.g. free-text description)
  AI_ASSISTED // AI may restructure/improve a MANUAL_INPUT value, but never invents facts
}

model DocumentTemplate {
  id          String       @id @default(cuid())
  name        String
  type        TemplateType
  language    String // "ar" | "fr" — the template file's own language
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  versions DocumentTemplateVersion[]

  @@index([type])
}

model DocumentTemplateVersion {
  id               String                @id @default(cuid())
  templateId       String
  template         DocumentTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber    Int
  status           TemplateVersionStatus @default(DRAFT)
  storageKey       String                @unique // private bucket — the uploaded .docx itself, untouched
  originalFilename String
  mimeType         String
  sizeBytes        Int
  // Placeholders detected by scanning the .docx's text runs for {{TOKEN}}
  // patterns at upload time (see lib/documents/template-engine.ts). Purely
  // informational/UI-driving — DocumentFieldMapping rows are the source of
  // truth for what actually gets substituted.
  detectedFields   String[]
  createdById      String
  createdBy        User                  @relation(fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())

  fieldMappings      DocumentFieldMapping[]
  generatedDocuments GeneratedDocument[]

  @@unique([templateId, versionNumber])
  @@index([templateId, status])
}

model DocumentFieldMapping {
  id                String                  @id @default(cuid())
  templateVersionId String
  templateVersion   DocumentTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  placeholder       String // e.g. "PLAYER_FIRST_NAME" (without the {{ }})
  label             String // human-readable prompt shown in the generation form
  sourceType        FieldSourceType
  // Dot-path into the structured data bundle the generation service builds
  // for the related entity (e.g. "match.homeTeamName", "player.firstName")
  // — only meaningful when sourceType is DATABASE_FIELD.
  sourcePath        String?

  @@unique([templateVersionId, placeholder])
}

model GeneratedDocument {
  id                String                  @id @default(cuid())
  templateVersionId String
  templateVersion   DocumentTemplateVersion @relation(fields: [templateVersionId], references: [id])
  relatedEntityType String? // "Match" | "MeetingMinute" | "Player" | "Correspondence" | null
  relatedEntityId   String?
  // The final resolved placeholder -> value map actually used to generate
  // this specific file — kept even if the source records change later, so
  // a generated document's history is never silently rewritten (spec:
  // "Do not silently change historical documents").
  inputData         Json
  aiUsed            Boolean                 @default(false)
  storageKey        String                  @unique // private bucket — the generated .docx
  mimeType          String
  sizeBytes         Int
  documentId        String?                 @unique // optional: registered into the main Document explorer
  document          Document?               @relation(fields: [documentId], references: [id])
  createdById       String
  createdBy         User                    @relation(fields: [createdById], references: [id])
  createdAt         DateTime                @default(now())

  @@index([relatedEntityType, relatedEntityId])
}

