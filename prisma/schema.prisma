// ============================================================================
// FOOTBALL CLUB PLATFORM — DATABASE SCHEMA
// ============================================================================
// Notes on design decisions:
//  - Auth uses NextAuth (Auth.js) with the Credentials provider + JWT
//    sessions (no Account/Session tables needed). `tokenVersion` on User lets
//    us invalidate all existing sessions instantly (force logout) when an
//    admin disables a user or a password changes — checked in the JWT
//    callback in src/lib/auth.ts.
//  - RBAC is real and DB-driven: Role <-> Permission is many-to-many via
//    RolePermission, not a hardcoded enum, so Super Admin can adjust which
//    permissions a role grants from Dashboard > Roles without a deploy.
//  - Content that appears on the public site in both languages (News,
//    Announcements, Player biography) uses a *Translation side table per
//    locale, so editors can genuinely publish independent Arabic and French
//    content — not just a UI-string translation. This is distinct from the
//    UI i18n system (src/i18n/messages/*.json), which only translates
//    interface labels/buttons, not admin-authored content.
//  - `DataClassification` implements section 46 of the spec directly:
//    PUBLIC / INTERNAL / RESTRICTED. Every Document carries a classification,
//    and secure download route (src/app/api/documents/[id]/download) checks
//    it against the caller's permissions server-side — see lib/permissions.ts.
//  - AuditLog rows are append-only from the application layer: no update/delete
//    server action exists for AuditLog. (For true immutability, add a DB
//    trigger/REVOKE UPDATE,DELETE at the database-user level in production.)
// ============================================================================

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

generator clientWorker {
  provider   = "prisma-client"
  output     = "../src/generated/prisma-worker"
  engineType = "client"
  runtime    = "workerd"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// AUTH / RBAC
// ----------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  image        String?
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0) // bump to invalidate all issued JWTs
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  lastSeenAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs                   AuditLog[]
  uploadedDocuments           Document[]                @relation("DocumentUploadedBy")
  ownedDocuments              Document[]                @relation("DocumentOwner")
  authoredNews                News[]
  createdAnnouncements        Announcement[]
  createdAlbums               Album[]
  correspondences             Correspondence[]
  meetingMinutes              MeetingMinute[]
  passwordResetTokens         PasswordResetToken[]
  documentTemplates           DocumentTemplate[]
  documentTemplateVersions    DocumentTemplateVersion[]
  generatedDocuments          GeneratedDocument[]
  notifications               Notification[]
  createdBudgets              Budget[]
  createdExpenses             Expense[]                 @relation("ExpenseCreatedBy")
  updatedExpenses             Expense[]                 @relation("ExpenseUpdatedBy")
  createdTreasuryAccounts     TreasuryAccount[]
  createdTreasuryTransactions TreasuryTransaction[]
  createdInventoryItems       InventoryItem[]           @relation("InventoryCreatedBy")
  conductedTestSessions       TestSession[]             @relation("UserConductedTestSessions")
  // P1 RBAC foundation — authorization assignment (approved Group: UserTeam).
  // Which teams THIS USER may access, independent of any Staff record.
  // Never derived from Staff/StaffTeam — see StaffTeam's own comment below.
  teamAssignments             UserTeam[]
  // P1 RBAC foundation — optional identity link only (approved Group: Staff.userId).
  // Connects this login to a Staff record for DISPLAY/IDENTITY purposes.
  // MUST NOT be read anywhere as a source of authorization: a user's team
  // access always comes from `teamAssignments` (UserTeam) above, never from
  // whatever teams the linked Staff record happens to work with.
  staff                       Staff?

  @@index([deletedAt, lastSeenAt])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "super_admin", "coach" — stable, code-referenced
  name        String // display name, editable
  description String?
  isSystem    Boolean  @default(false) // system roles (super_admin) cannot be deleted
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
  // P1 RBAC foundation (approved Phase 0C, Group 1): when true, every user of
  // this role is restricted to the teams recorded in their UserTeam rows.
  // Default false preserves every existing role's current (unrestricted)
  // behavior exactly — this column changes nothing until a later phase
  // (a) sets it true on a role and (b) wires enforcement into resources.
  // Team scope is intentionally role-level, not per-permission — see the
  // approved architecture decision (Group 1) for the rationale.
  teamScoped  Boolean          @default(false)
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "players.create", "documents.view.restricted"
  group       String // e.g. "players", "documents" — for grouping in the Roles UI
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ----------------------------------------------------------------------------
// SHARED ENUMS
// ----------------------------------------------------------------------------

enum DataClassification {
  PUBLIC
  INTERNAL
  RESTRICTED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// ----------------------------------------------------------------------------
// PLAYERS & STAFF
// ----------------------------------------------------------------------------

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum PlayerStatus {
  ACTIVE
  INJURED
  SUSPENDED
  ON_LOAN
  ARCHIVED
}

// ============================================================================
// TEAM / CATEGORY (spec sections 3–7) — a real business entity, not a
// scattered string. Exactly four rows in practice (SENIOR/U20/U17/U15);
// `category` is unique so there's one canonical team per category.
// birthYearFrom/To are null for SENIOR (no youth birth-year restriction).
// ============================================================================
enum TeamCategory {
  SENIOR
  U20
  U17
  U15
}

model Team {
  id            String       @id @default(cuid())
  name          String // admin-editable display label, e.g. "Espoir Sidi Hosni — Seniors"
  shortName     String?
  category      TeamCategory @unique
  birthYearFrom Int?
  birthYearTo   Int?
  description   String?      @db.Text
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  players          Player[]
  staff            Staff[]
  matches          Match[]
  competitions     Competition[]
  trainingSessions TrainingSession[]
  contracts        Contract[]
  documents        Document[]
  calendarEvents   CalendarEvent[]
  announcements    Announcement[]
  albums           Album[]
  correspondences  Correspondence[]
  meetingMinutes   MeetingMinute[]
  budgets          Budget[]
  expenses         Expense[]
  inventoryItems   InventoryItem[]
  testSessions     TestSession[]
  // P1 RBAC foundation — reverse relations for the two new assignment tables.
  userAssignments  UserTeam[]
  staffAssignments StaffTeam[]
}

// ============================================================================
// P1 RBAC FOUNDATION — two intentionally separate assignment tables.
// ----------------------------------------------------------------------------
// UserTeam  = AUTHORIZATION. Read by the server to decide what a logged-in
//             User's session may access. Nothing else derives from it and it
//             derives from nothing else (not from StaffTeam, not from
//             Staff.teamId). Composite primary key doubles as the uniqueness
//             constraint (no duplicate user/team membership possible at the
//             database level — not an application-only check).
// StaffTeam = OPERATIONAL assignment. Which teams a Staff member works with
//             day to day (coaching, administration). Read by later phases for
//             things like "which teams can this coach be assigned to a
//             training session for" — never for authorization.
// Both are additive, both fail closed by simply having no rows (a
// `teamScoped` user with zero UserTeam rows is scoped to nothing, not to
// everything — enforced in the policy module below, not by the schema).
// ============================================================================
model UserTeam {
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, teamId])
  @@index([teamId]) // reverse lookup: "who is assigned to team X" — @@id([userId, teamId]) already indexes the userId-first direction
}

model StaffTeam {
  staffId   String
  teamId    String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([staffId, teamId])
  @@index([teamId])
}

model Player {
  id            String         @id @default(cuid())
  slug          String         @unique
  firstName     String
  lastName      String
  photoUrl      String?
  shirtNumber   Int?
  position      PlayerPosition
  nationality   String
  dateOfBirth   DateTime
  height        Int? // cm
  preferredFoot PreferredFoot?
  joiningDate   DateTime?
  biography     String?        @db.Text
  status        PlayerStatus   @default(ACTIVE)
  internalNotes String?        @db.Text // INTERNAL — never exposed on public site
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Nullable so this migration never destroys pre-existing rows (spec
  // section 9: "Do not destroy existing data during migrations") — the seed
  // backfills demo players onto a real team, and the dashboard form requires
  // a team going forward, but the column itself stays optional at the DB
  // level.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  translations           PlayerTranslation[]
  statistics             PlayerStatistic[]
  contracts              Contract[]
  documents              Document[]
  matchEvents            MatchEvent[]
  matchLineups           MatchLineup[]
  trainingAttendances    TrainingAttendance[]
  correspondences        Correspondence[]
  firstNameFr            String?
  lastNameFr             String?
  weight                 Float? // kg (e.g. 72.5)
  previousTeam           String? // Previous club / team of origin
  birthCertificateNumber String? // Official birth certificate number
  licenceNumber          String? // Official player licence number
  testResults            TestResult[]

  @@index([status])
  @@index([position])
  @@index([teamId])
}

// Per-locale biography content (real translated content, not just UI labels)
model PlayerTranslation {
  id        String @id @default(cuid())
  playerId  String
  locale    String // "ar" | "fr"
  biography String @db.Text
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, locale])
}

model PlayerStatistic {
  id            String @id @default(cuid())
  playerId      String
  player        Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId      String
  season        Season @relation(fields: [seasonId], references: [id])
  appearances   Int    @default(0)
  goals         Int    @default(0)
  assists       Int    @default(0)
  yellowCards   Int    @default(0)
  redCards      Int    @default(0)
  minutesPlayed Int    @default(0)

  @@unique([playerId, seasonId])
}

enum StaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  GOALKEEPING_COACH
  FITNESS_COACH
  MEDICAL_STAFF
  ADMINISTRATIVE_STAFF
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Staff {
  id              String      @id @default(cuid())
  firstName       String
  lastName        String
  role            StaffRole
  photoUrl        String?
  biography       String?     @db.Text
  internalContact String? // phone/email — INTERNAL, never public
  status          StaffStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  contracts        Contract[]
  documents        Document[]
  trainingSessions TrainingSession[]
  correspondences  Correspondence[]
  firstNameFr      String?
  lastNameFr       String?
  // Single-team FK — RETAINED for P1 (approved staged migration, Group 2).
  // Existing consumers (Contract.resolveSubjectTeamId, TrainingSession.coachId
  // displays, this model's own list/detail pages) keep reading this column
  // unchanged. It is NOT removed or redefined in P1. `teamAssignments` below
  // is the new multi-team model that later phases migrate those consumers to;
  // until then the two are independent and this column is the sole source of
  // truth for "this staff member's team" wherever that is still read.
  // P1 RBAC foundation — operational assignment (StaffTeam), approved Group 2.
  // Which teams this staff member actually works with. NOT an authorization
  // mechanism: adding/removing a row here must never change what any User
  // (including one linked via `userId` below) is allowed to access. Only
  // `User.teamAssignments` (UserTeam) grants access.
  teamAssignments  StaffTeam[]
  // P1 RBAC foundation — optional identity link only (approved Group: Staff.userId).
  // Nullable + unique: at most one Staff record per User, and a Staff record
  // may have no linked User at all (most staff never log in). This column
  // MUST NOT be consulted for authorization anywhere — see the matching
  // comment on User.staff above.
  userId           String?           @unique
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

// ----------------------------------------------------------------------------
// CONTRACTS
// ----------------------------------------------------------------------------

enum ContractStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  PENDING
}

model Contract {
  id         String         @id @default(cuid())
  type       String // e.g. "Professional", "Amateur", "Loan", "Staff"
  playerId   String?
  player     Player?        @relation(fields: [playerId], references: [id])
  staffId    String?
  staff      Staff?         @relation(fields: [staffId], references: [id])
  teamId     String?
  team       Team?          @relation(fields: [teamId], references: [id])
  startDate  DateTime
  endDate    DateTime
  status     ContractStatus @default(PENDING)
  notes      String?        @db.Text
  documentId String?        @unique
  document   Document?      @relation(fields: [documentId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status])
  @@index([endDate])
  @@index([teamId])
}

// ----------------------------------------------------------------------------
// DOCUMENT MANAGEMENT (private storage — see src/lib/storage.ts)
// ----------------------------------------------------------------------------

model DocumentCategory {
  id        String             @id @default(cuid())
  key       String             @unique // e.g. "contract", "correspondence"
  name      String
  parentId  String?
  parent    DocumentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  DocumentCategory[] @relation("CategoryHierarchy")
  documents Document[]
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

enum MatchDocumentType {
  PRE_MATCH_SHEET
  REFEREE_REPORT
}

model Document {
  id                String             @id @default(cuid())
  name              String
  categoryId        String
  category          DocumentCategory   @relation(fields: [categoryId], references: [id])
  description       String?            @db.Text
  documentDate      DateTime?
  classification    DataClassification @default(INTERNAL)
  department        String?
  status            DocumentStatus     @default(PENDING_REVIEW)
  matchDocumentType MatchDocumentType?

  // Private storage pointers — NEVER a public URL. See lib/storage.ts.
  storageKey   String @unique // object key inside the private bucket
  mimeType     String
  sizeBytes    Int
  originalName String

  ownerId      String
  owner        User   @relation("DocumentOwner", fields: [ownerId], references: [id])
  uploadedById String
  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  relatedPlayerId String?
  relatedPlayer   Player? @relation(fields: [relatedPlayerId], references: [id])
  relatedStaffId  String?
  relatedStaff    Staff?  @relation(fields: [relatedStaffId], references: [id])
  relatedMatchId  String?
  relatedMatch    Match?  @relation(fields: [relatedMatchId], references: [id])
  teamId          String?
  team            Team?   @relation(fields: [teamId], references: [id])

  contract                  Contract?
  correspondenceAttachments CorrespondenceAttachment[]
  meetingAttachments        MeetingAttachment[]
  generatedFrom             GeneratedDocument?
  expense                   Expense?
  treasuryTransaction       TreasuryTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([classification])
  @@index([relatedPlayerId])
  @@index([teamId])
  @@index([relatedMatchId, matchDocumentType])
}

// ----------------------------------------------------------------------------
// CORRESPONDENCE & MEETING MINUTES
// ----------------------------------------------------------------------------

enum CorrespondenceType {
  INCOMING
  OUTGOING
}

enum CorrespondenceStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Correspondence {
  id                String                     @id @default(cuid())
  referenceNumber   String                     @unique
  subject           String
  sender            String
  recipient         String
  date              DateTime
  type              CorrespondenceType
  priority          Priority                   @default(NORMAL)
  status            CorrespondenceStatus       @default(NEW)
  responsibleUserId String
  responsibleUser   User                       @relation(fields: [responsibleUserId], references: [id])
  teamId            String?
  team              Team?                      @relation(fields: [teamId], references: [id])
  relatedPlayerId   String?
  relatedPlayer     Player?                    @relation(fields: [relatedPlayerId], references: [id])
  relatedStaffId    String?
  relatedStaff      Staff?                     @relation(fields: [relatedStaffId], references: [id])
  relatedMatchId    String?
  relatedMatch      Match?                     @relation(fields: [relatedMatchId], references: [id])
  notes             String?                    @db.Text
  attachments       CorrespondenceAttachment[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([teamId])
  @@index([status])
  @@index([type])
}

model CorrespondenceAttachment {
  correspondenceId String
  documentId       String
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  document         Document       @relation(fields: [documentId], references: [id])

  @@id([correspondenceId, documentId])
}

enum MeetingStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model MeetingMinute {
  id                  String              @id @default(cuid())
  title               String
  date                DateTime
  location            String?
  attendees           String[] // simple list of names; link to User where relevant via notes
  teamId              String?
  team                Team?               @relation(fields: [teamId], references: [id])
  agenda              String?             @db.Text
  content             String              @db.Text
  decisions           String?             @db.Text
  notes               String?             @db.Text
  responsiblePersonId String
  responsiblePerson   User                @relation(fields: [responsiblePersonId], references: [id])
  status              MeetingStatus       @default(DRAFT)
  calendarEventId     String?             @unique
  calendarEvent       CalendarEvent?      @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  attachments         MeetingAttachment[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([teamId])
}

model MeetingAttachment {
  meetingId  String
  documentId String
  meeting    MeetingMinute @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  document   Document      @relation(fields: [documentId], references: [id])

  @@id([meetingId, documentId])
}

// ----------------------------------------------------------------------------
// COMPETITIONS, SEASONS & MATCHES
// ----------------------------------------------------------------------------

model Season {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. "2026/2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  competitions Competition[]
  statistics   PlayerStatistic[]
  budgets      Budget[]
  expenses     Expense[]
}

enum CompetitionStatus {
  UPCOMING
  ONGOING
  FINISHED
}

enum CompetitionType {
  LEAGUE
  CUP
}

model Competition {
  id           String            @id @default(cuid())
  name         String
  organization String?
  seasonId     String
  season       Season            @relation(fields: [seasonId], references: [id])
  teamId       String?
  team         Team?             @relation(fields: [teamId], references: [id])
  status       CompetitionStatus @default(UPCOMING)

  matches       Match[]
  type          CompetitionType @default(LEAGUE)
  logoUrl       String?
  standingsData Json?
  bracketData   Json?

  @@index([teamId])
  @@index([type])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

model Match {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  teamId        String?
  team          Team?       @relation(fields: [teamId], references: [id])
  homeTeamName  String // "Our Club" or opponent name
  awayTeamName  String
  isHomeFixture Boolean     @default(true) // whether the club plays at home
  homeScore     Int?
  awayScore     Int?
  matchDate     DateTime
  stadium       String?
  refereeName   String?
  status        MatchStatus @default(SCHEDULED)
  matchReport   String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  events          MatchEvent[]
  lineups         MatchLineup[]
  documents       Document[]
  calendarEvent   CalendarEvent?
  media           Media[]
  correspondences Correspondence[]
  expenses        Expense[]

  @@index([matchDate])
  @@index([status])
  @@index([teamId])
}

/// Public opponent club crests cached for reuse across future fixtures.
model OpponentClub {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  logoUrl        String
  stadium        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION_IN
  SUBSTITUTION_OUT
}

model MatchEvent {
  id       String         @id @default(cuid())
  matchId  String
  match    Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String?
  player   Player?        @relation(fields: [playerId], references: [id])
  type     MatchEventType
  minute   Int
  notes    String?
}

model MatchLineup {
  matchId    String
  playerId   String
  match      Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player     Player  @relation(fields: [playerId], references: [id])
  isStarting Boolean @default(true)
  position   String?

  @@id([matchId, playerId])
}

// ----------------------------------------------------------------------------
// CALENDAR & TRAINING
// ----------------------------------------------------------------------------

enum CalendarEventType {
  MATCH
  TRAINING
  MEETING
  ADMINISTRATIVE
  OTHER
}

model CalendarEvent {
  id                String            @id @default(cuid())
  title             String
  type              CalendarEventType
  startDateTime     DateTime
  endDateTime       DateTime
  location          String?
  description       String?           @db.Text
  teamId            String?
  team              Team?             @relation(fields: [teamId], references: [id])
  relatedMatchId    String?           @unique
  relatedMatch      Match?            @relation(fields: [relatedMatchId], references: [id])
  relatedTrainingId String?           @unique
  relatedTraining   TrainingSession?  @relation(fields: [relatedTrainingId], references: [id])
  meetingMinute     MeetingMinute?
  createdAt         DateTime          @default(now())

  @@index([startDateTime])
  @@index([teamId])
}

enum TrainingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model TrainingSession {
  id        String         @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  location  String?
  coachId   String?
  coach     Staff?         @relation(fields: [coachId], references: [id])
  teamId    String?
  team      Team?          @relation(fields: [teamId], references: [id])
  notes     String?        @db.Text
  status    TrainingStatus @default(SCHEDULED)

  calendarEvent CalendarEvent?
  attendances   TrainingAttendance[]
  expenses      Expense[]

  @@index([teamId])
}

model TrainingAttendance {
  trainingId String
  playerId   String
  training   TrainingSession  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player     Player           @relation(fields: [playerId], references: [id])
  status     AttendanceStatus @default(PRESENT)

  @@id([trainingId, playerId])
}

// Spec section 13: attendance must be one of these four states, not a
// simple present/absent boolean.
enum AttendanceStatus {
  PRESENT
  ABSENT
  INJURED
  EXCUSED
}

// ----------------------------------------------------------------------------
// NEWS & ANNOUNCEMENTS (CMS)
// ----------------------------------------------------------------------------

model News {
  id               String        @id @default(cuid())
  featuredImageUrl String?
  category         String?
  tags             String[]
  authorId         String
  author           User          @relation(fields: [authorId], references: [id])
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  scheduledFor     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  translations NewsTranslation[]
  imageUrls    String[]          @default([])

