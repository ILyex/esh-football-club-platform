{
  "name": "football-club-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Professional Football Club Website & Management Platform (Next.js, Prisma, PostgreSQL, next-intl AR/FR RTL-LTR)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-wasm.mjs",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "build:cpanel": "npm run build && node scripts/prepare-cpanel.mjs",
    "package:cpanel": "node scripts/package-cpanel.mjs",
    "start": "next start",
    "start:cpanel": "node app.js",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "worker": "tsx scripts/worker.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:finance": "tsx --tsconfig tests/finance/tsconfig.unit.json --test tests/finance/unit/*.test.ts",
    "test:finance:integration": "tsx --tsconfig tests/finance/tsconfig.integration.json --test tests/finance/integration/*.test.ts",
    "test:rbac": "tsx --tsconfig tests/rbac/tsconfig.unit.json --test tests/rbac/unit/*.test.ts",
    "test:testing": "tsx --tsconfig tests/testing/tsconfig.unit.json --test tests/testing/unit/*.test.ts",
    "test:security:deps": "node scripts/check-braces-hardening.mjs",
    "test:ratelimit:integration": "tsx --tsconfig tests/finance/tsconfig.integration.json scripts/check-rate-limit-db.ts",
    "test:all": "npm run test:finance && npm run test:rbac && npm run test:testing && npm run test:security:deps"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@types/sanitize-html": "^2.16.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx-preview": "^0.4.1",
    "docxtemplater": "^3.55.0",
    "file-type": "^21.3.1",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "pg": "8.16.3",
    "pizzip": "^3.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.13.3",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "fill-range": "^7.1.1",
    "postcss": "^8.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "braces": "file:vendor/braces",
    "deepmerge-ts": "8.0.2",
    "next-intl": {
      "@swc/core": "1.16.0"
    }
  }
}
