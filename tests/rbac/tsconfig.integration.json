{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "server-only": ["tests/finance/mocks/empty.ts"],
      "next/headers": ["tests/finance/mocks/next-headers.ts"],
      "next/cache": ["tests/finance/mocks/next-cache.ts"],
      "next/navigation": ["tests/finance/mocks/next-navigation.ts"],
      "@/*": ["./src/*"]
    }
  }
}
