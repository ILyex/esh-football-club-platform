# ============================================================================
# ESH FOOTBALL CLUB PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# This file lists all environment variables recognized by the platform.
# All values shown below are non-sensitive examples and placeholders.
# NEVER commit real credentials or .env files into version control.
# ============================================================================

# ============================================================================
# 1. DATABASE CONFIGURATION (MANDATORY)
# ============================================================================
# PostgreSQL 14+ is required.
# In production, ensure sslmode=require and pool connection parameters.
# Example: postgresql://user:password@host:5432/db_name?sslmode=require&connection_limit=10
DATABASE_URL="postgresql://user:password@host:5432/football_club?sslmode=require"

# ============================================================================
# 2. AUTHENTICATION & SECURITY (MANDATORY IN PRODUCTION)
# ============================================================================
# Secret key used by Auth.js (NextAuth v5) to sign and encrypt session tokens.
# Generate with: openssl rand -base64 32
# In production, must be at least 32 characters of high-entropy randomness.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Canonical canonical application URL (used for OAuth redirects and canonical links)
NEXTAUTH_URL="https://dashboard.esh-club.dz"

# ============================================================================
# 3. BACKGROUND JOBS & CRON (MANDATORY IN PRODUCTION)
# ============================================================================
# Secret required to authenticate HTTP requests to /api/cron/process-jobs.
# Used by external schedulers (Vercel Cron, systemd timer, cron daemon, Cloud Scheduler).
# Evaluated via constant-time comparison (crypto.timingSafeEqual).
CRON_SECRET="replace-with-a-random-32-byte-cron-secret"

# ============================================================================
# 4. PRIVATE FILE STORAGE — S3-COMPATIBLE (SENSITIVE DOCUMENTS)
# ============================================================================
# Authoritative storage for contracts, official correspondence, and generated DOCX.
# The bucket MUST be configured as PRIVATE (zero public access).
# Compatible with Cloudflare R2, AWS S3, Supabase Storage, MinIO.
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="your-s3-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-s3-secret-access-key"
STORAGE_PRIVATE_BUCKET="esh-private-documents"
STORAGE_FORCE_PATH_STYLE="true"   # "true" for Cloudflare R2 / MinIO; "false" for AWS S3

# ============================================================================
# 5. PUBLIC MEDIA STORAGE — S3-COMPATIBLE (PUBLIC ASSETS)
# ============================================================================
# Storage for public gallery images, player avatars, and news cover photos.
# MUST NOT be the same bucket as STORAGE_PRIVATE_BUCKET.
STORAGE_PUBLIC_BUCKET="esh-public-media"
STORAGE_PUBLIC_BASE_URL="https://media.esh-club.dz"

# ============================================================================
# 6. PLUGGABLE PDF CONVERTER (OPTIONAL)
# ============================================================================
# Headless LibreOffice or Gotenberg conversion microservice endpoint.
# If unconfigured, the platform defaults to in-browser DOCX rendering + native print-to-PDF.
# Example: http://gotenberg:3000/forms/libreoffice/convert
PDF_CONVERTER_URL=""

# ============================================================================
# 7. LOCAL AI SUBSYSTEM — OLLAMA & OPEN-WEIGHT (OPTIONAL)
# ============================================================================
# Self-hosted local inference subsystem. Keep Ollama on a trusted local network.
# The app sends only task-specific text or bounded images for inference.
AI_ENABLED="true"
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_VISION_MODEL="llava:7b"
OLLAMA_TIMEOUT_MS="30000"
OLLAMA_MAX_OUTPUT_TOKENS="2048"
OLLAMA_TEMPERATURE="0.2"

# ============================================================================
# 8. OFFICIAL GMAIL MODULE — GOOGLE OAUTH 2.0 (OPTIONAL / BLOCKED PENDING CREDS)
# ============================================================================
# Used for the official ESH club inbox module.
# Requires OAuth 2.0 Client credentials created in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://dashboard.esh-club.dz/api/auth/google/callback"
# Optional local/demo adapter only. Ignored in production.
GMAIL_USE_MOCK="false"

# AES-256 key (32 bytes / 64 hex chars or 44 base64 chars) for encrypting tokens at rest
GMAIL_TOKEN_ENCRYPTION_KEY=""

# ============================================================================
# 9. FAF CONNECT FEDERATION INTEGRATION (PORTAL ACCESS ONLY UNTIL API CONTRACT)
# ============================================================================
# Credentials provide portal access only. Automatic import stays blocked until an authorized data API/export contract is configured.
FAF_ENABLED="false"
FAF_PORTAL_URL="https://connect.faf.dz"
FAF_CLUB_CODE="ESH-14-001"
FAF_USERNAME=""
FAF_PASSWORD=""
# Prefer a separate random secret (at least 32 characters) for encrypting the
# persisted FAF session cookie. AUTH_SECRET is a fallback when this is empty.
FAF_SESSION_ENCRYPTION_KEY=""
FAF_TIMEOUT_MS="20000"
FAF_RATE_LIMIT_DELAY_MS="1000"

# ============================================================================
# 10. OPERATIONAL SEED & INITIAL ROOT ADMIN SETUP
# ============================================================================
# DEMO_PASSWORD: Used ONLY by `npm run db:seed` in development.
# In production, seed.ts strictly skips demo accounts unless ALLOW_DEMO_SEED=true.
DEMO_PASSWORD="ChangeMe123!"

# Provisioning initial production Super Admin (used by `npm run bootstrap:admin`):
# ADMIN_EMAIL="president@esh-club.dz"
# ADMIN_PASSWORD="Minimum12CharactersSecurePassword!"
# ADMIN_NAME="President ESH"
